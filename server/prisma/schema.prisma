// datasource and generator should match your setup
// Ensure provider is "postgresql"
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Enums for controlled vocabulary ---

enum MediaWorkType {
  BOOK
  FILM // Standalone film
  DOCUMENTARY // Standalone documentary
  DOCUSERIES // Multi-part documentary series
  PODCAST_SERIES
  TV_SERIES // e.g., 20/20, Dateline
  ACADEMIC_PAPER
  NEWS_ARTICLE
  OTHER
  UNKNOWN
}

enum MediaItemType {
  PODCAST_EPISODE
  TV_EPISODE
  BOOK_CONTENT      // Represents the content of a standalone BOOK MediaWork
  FILM_CONTENT      // Represents the content of a standalone FILM MediaWork
  DOCUMENTARY_CONTENT // Represents the content of a standalone DOCUMENTARY MediaWork
  BOOK_CHAPTER      // Future use: If breaking books down
  ARTICLE
  ACADEMIC_PAPER
  OTHER
  UNKNOWN
}

enum IndividualStatus {
  EXONERATED // Fully cleared
  RELEASED_ALFORD_PLEA // Released but didn't admit guilt / maintains innocence
  RELEASED_CLEMENCY // Released via pardon/commutation but conviction may stand
  RELEASED_TIME_SERVED // Released after serving sentence or via plea for time served
  CONVICTION_OVERTURNED // Overturned, awaiting retrial/dismissal
  EXECUTED
  CONVICTED // Currently convicted/incarcerated
  OTHER // For cases that don't fit neatly
  UNKNOWN
}

enum OrganizationType {
  INNOCENCE_ORG // e.g., Innocence Project, EJI
  LEGAL_AID
  LAW_FIRM
  LAW_ENFORCEMENT // e.g., Police Dept, DA Office
  GOVERNMENT_AGENCY
  SUPPORT_GROUP // e.g., After Innocence
  MEDIA_ORG // e.g., Production Company, Network, Publisher
  UNIVERSITY
  OTHER
  UNKNOWN
}

enum InvolvedPersonRole {
  LAWYER_DEFENSE
  LAWYER_PROSECUTION
  JUDGE
  WITNESS_EYEWITNESS
  WITNESS_ALIBI
  WITNESS_EXPERT
  WITNESS_INFORMANT // Jailhouse informant etc.
  POLICE_DETECTIVE
  POLICE_OFFICER
  VICTIM
  FAMILY_MEMBER
  JOURNALIST
  AUTHOR // Author of book/article
  DIRECTOR // Director of film/doc
  HOST // Host of podcast
  ACTIVIST
  ACCUSER
  ACTUAL_PERPETRATOR
  CO_DEFENDANT
  // Roles specific to individuals in the story
  SUBJECT_EXONEREE // The main person wrongfully convicted in the narrative
  SUBJECT_OTHER // Other central figures in the narrative
  OTHER
  UNKNOWN
}

enum OrganizationLinkType {
  WEBSITE // Primary website (could potentially replace the main 'website' field on Organization)
  ARTICLE
  SOCIAL_MEDIA
  REPORT
  OTHER
}

// --- NEW ENUM for Streaming Provider Type ---
enum StreamingType {
  SUBSCRIPTION
  RENT
  BUY
  FREE
  OTHER
  UNKNOWN
}

// --- NEW ENUM for User Roles ---
enum UserRole {
  USER   // Basic user, might have read-only access or limited write access in future
  EDITOR // Can create and edit content
  ADMIN  // Full control, including user management
}

// --- Human Verification & Claim Strength Enums ---
enum VerificationStatus {
  UNVERIFIED
  IN_REVIEW
  VERIFIED
  DISPUTED
}

enum InnocenceClaimStrength {
  FORMALLY_EXONERATED
  OFFICIAL_RELIEF_NO_EXONERATION
  STRONG_NEW_EVIDENCE
  CREDIBLE_CLAIM
  UNASSESSED
}

// --- Core Models ---

// --- NEW User Model ---
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique // Used for login
  passwordHash String   // Stores the hashed password, never the plain text
  firstName    String?
  lastName     String?
  role         UserRole @default(USER) // Default role for new users
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Verification Audit Relations ---
  verifiedIndividuals         Individual[]         @relation("IndividualVerifiedBy")
  verifiedMediaWorks          MediaWork[]          @relation("MediaWorkVerifiedBy")
  verifiedMediaItems          MediaItem[]          @relation("MediaItemVerifiedBy")
  verifiedOrganizations       Organization[]       @relation("OrganizationVerifiedBy")
  verifiedContributingFactors ContributingFactor[] @relation("FactorVerifiedBy")
  verifiedInvolvedPersons     InvolvedPerson[]     @relation("PersonVerifiedBy")

  @@map("users") // Explicit table name
}

// --- IndividualGroup Model ---
model IndividualGroup {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., "Central Park Five", "West Memphis Three"
  description String?  @db.Text // Optional: Brief description or context about the group/case
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Relationships ---
  // Many-to-many relationship with Individual
  members Individual[] @relation("IndividualGroupMembership")

  @@map("individual_groups") // Explicit table name
}

// --- MediaItemSourceLink Model ---
model MediaItemSourceLink {
  id          Int      @id @default(autoincrement())
  url         String   // The specific URL mentioned (e.g., GoFundMe, article)
  description String?  @db.Text // Optional: Context (e.g., "GoFundMe mentioned at 10:30", "Related news article")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Relationships ---
  mediaItem   MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)
  mediaItemId Int       // Foreign key back to the MediaItem

  @@map("media_item_source_links")
}

// --- MediaWork Model (with new fields for external data and streaming) ---
model MediaWork {
  id                       Int           @id @default(autoincrement())
  title                    String
  workType                 MediaWorkType
  creatorName              String?
  publicationOrReleaseYear Int?
  publisherOrNetwork       String?
  focusOrTheme             String?       @db.Text
  summaryNotes             String?       @db.Text // General summary, can be populated from external sources
  availabilityNotes        String?       @db.Text // General availability, e.g., "Out of print"
  sourceUrl                String?       // General source URL, e.g., to a series homepage
  aiGenerated              Boolean       @default(true)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // --- NEW Fields for Generic External API data ---
  // For films, this would be the TMDB ID. For books, could be ISBN or OpenLibrary ID, etc.
  externalId               String?       @unique
  // Path to a primary image (e.g., poster for films, cover for books).
  // This would be a relative path; the base URL (e.g., TMDB's image base URL) would be handled in application logic.
  imagePath                String?
  // Timestamp of when data from the external source (identified by externalId) was last fetched/updated for this work.
  lastExternalFetch        DateTime?
  sourcingCredit           String? @map("SourcingCredit") // To store sourcing credit, e.g., for TMDB

  // --- Verification & Ingestion Tracking ---
  verificationStatus       VerificationStatus @default(UNVERIFIED)
  verifiedAt               DateTime?
  verifiedById             Int?
  verifiedBy               User?              @relation("MediaWorkVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes        String?            @db.Text
  ingestionSource          String?
  importBatchId            String?

  // --- Relationships ---
  items MediaItem[]
  streamingProviders StreamingProvider[]
  bookPurchaseDetails      BookPurchaseDetails?
  featuredAsBook           FeaturedContentSetting[] @relation("FeaturedBook")
  featuredAsPodcast        FeaturedContentSetting[] @relation("FeaturedPodcast")
  featuredAsFilm           FeaturedContentSetting[] @relation("FeaturedFilm")

  @@index([workType])
  @@index([verificationStatus])
  @@map("media_works")
}


model BookPurchaseDetails {
  id                      Int      @id @default(autoincrement())
  mediaWorkId             Int      @unique // Foreign key to MediaWork
  mediaWork               MediaWork @relation(fields: [mediaWorkId], references: [id], onDelete: Cascade)

  // Fields from Google Books API
  subtitle                String?
  pageCount               Int?
  googleBooksPreviewLink  String?  // volumeInfo.previewLink
  googleBooksWebReaderLink String? // accessInfo.webReaderLink
  googleBooksBuyLink      String?  // saleInfo.buyLink (from Google Play)
  googleBooksCategories   String[] // list of categories/subjects

  // Purchase info you might add/curate
  amazonPurchaseUrl       String?
  amazonPriceAmount       Float?
  amazonPriceCurrency     String?
  // You could add fields for other vendors too if desired

  listPriceAmount         Float?   // from saleInfo.listPrice.amount
  listPriceCurrency       String?  // from saleInfo.listPrice.currencyCode
  retailPriceAmount       Float?   // from saleInfo.retailPrice.amount
  retailPriceCurrency     String?  // from saleInfo.retailPrice.currencyCode
  isEbookGoogle           Boolean? // from saleInfo.isEbook (Google Play)
  saleabilityGoogle       String?  // from saleInfo.saleability (Google Play)
  viewabilityGoogle       String?  // from accessInfo.viewability

  lastApiCheck            DateTime @default(now()) // Renamed from lastApiCheck_api for consistency
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("book_purchase_details")
}

// --- NEW MODEL: StreamingProvider ---
// Stores details about where a MediaWork (typically film/series) can be streamed, rented, or bought.
// Data primarily sourced from Watchmode API, linked via MediaWork.externalId (TMDB ID for films).
model StreamingProvider {
  id                  Int           @id @default(autoincrement())
  providerName        String        // e.g., "Netflix", "Amazon Prime Video", "iTunes"
  watchmodeProviderId Int?          // Watchmode's unique ID for the provider (if available)
  streamingType       StreamingType // e.g., SUBSCRIPTION, RENT, BUY
  url                 String?       // Deeplink to the content on the provider's site/app
  priceCurrency       String?       // e.g., "USD" (for RENT/BUY)
  priceAmount         Float?        // e.g., 3.99 (for RENT/BUY)
  presentationQuality String?       // e.g., "HD", "SD", "4K"
  lastChecked         DateTime      // Timestamp of when this specific streaming option was last checked/updated
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // --- Relationships ---
  mediaWork   MediaWork @relation(fields: [mediaWorkId], references: [id], onDelete: Cascade)
  mediaWorkId Int       // Foreign key back to the MediaWork

  @@unique([mediaWorkId, providerName, streamingType, presentationQuality]) // Ensure uniqueness for a given film, provider, type, and quality
  @@map("streaming_providers")
}


// --- MediaItem Model ---
model MediaItem {
  id                         Int                  @id @default(autoincrement())
  itemTitle                  String?
  itemNumber                 String?              // e.g., Episode number, Chapter number
  itemMediaType              MediaItemType
  releaseDate                DateTime?
  hostOrNarrator             String?
  focusOrTheme               String?              @db.Text
  summaryNotes               String?              @db.Text
  keyQuotes                  String?              @db.Text
  transcript                 String?              @db.Text
  durationSeconds            Int?
  sourceUrl                  String?
  aiGenerated                Boolean              @default(true)
  verificationStatus         VerificationStatus   @default(UNVERIFIED)
  verifiedAt                 DateTime?
  verifiedById               Int?
  verifiedBy                 User?                @relation("MediaItemVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes          String?              @db.Text
  ingestionSource            String?
  importBatchId              String?
  canonicalKey               String?              @unique
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  // --- Relationships ---
  work                       MediaWork            @relation(fields: [workId], references: [id], onDelete: Cascade)
  workId                     Int

  individualsFeatured        Individual[]         @relation("ItemFeaturingIndividuals")
  involvedPersonsMentioned   InvolvedPerson[]     @relation("ItemMentioningPersons")
  organizationsMentioned     Organization[]       @relation("ItemMentioningOrganizations")
  contributingFactorsMentioned ContributingFactor[] @relation("ItemMentioningFactors")

  relatedMediaItems          MediaItem[]          @relation("RelatedMediaItems") // MediaItems related TO this one
  relatedToMediaItems        MediaItem[]          @relation("RelatedMediaItems") // MediaItems THIS one is related to

  externalLinks              MediaItemSourceLink[] // Links mentioned within the item

  // Ensures an episode number (or title) is unique within a specific media work
  @@unique([workId, itemNumber, itemTitle]) // Modified to ensure uniqueness on itemNumber OR itemTitle within a work
  @@index([workId])
  @@index([verificationStatus])
  @@map("media_items")
}


// --- IndividualSourceLink Model (Join Table) ---
// Note: The @@unique([individualId, informationSourceId]) constraint has been removed
// as per earlier discussions to allow multiple links from the same individual to the same source.
// The @@unique([individualId, specificUrl]) from your schema.txt is retained.
model IndividualSourceLink {
  id                  Int               @id @default(autoincrement())
  specificUrl         String            // The specific URL linking this individual to this source
  headline            String?           // NEW: The headline of the linked article/source
  // You might consider adding a field here to describe the context or reason for this specific link,
  // especially now that multiple links between the same individual and source are allowed.
  // For example: linkContext String? @db.Text
  description         String?           @db.Text // Optional: Context or reason for this specific link (can be used if headline is not enough)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  // --- Relationships ---
  individual          Individual        @relation("IndividualLinks", fields: [individualId], references: [id], onDelete: Cascade)
  individualId        Int
  informationSource   InformationSource @relation("SourceLinks", fields: [informationSourceId], references: [id], onDelete: Cascade)
  informationSourceId Int

  @@unique([individualId, specificUrl]) // Retained from your schema.txt
  @@map("individual_source_links")
}



// --- InformationSource Model ---
model InformationSource {
  id              Int                    @id @default(autoincrement())
  name            String                 @unique
  baseUrl         String?
  // specificUrl     String?                // May be less relevant now with join table - REMOVED as per schema.txt not having it.
  retrievedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // --- Relationships ---
  individualLinks IndividualSourceLink[] @relation("SourceLinks")

  @@map("information_sources")
}


// --- Individual Model (Includes latest updates) ---
model Individual {
  id                         Int                @id @default(autoincrement())
  firstName                  String
  middleName                 String?
  lastName                   String
  suffix                     String?
  nickname                   String?
  disambiguationTag          String?            // e.g., "NRE Case 123", "Witness", "b.1990", "From City X"
  canonicalKey               String?            @unique
  status                     IndividualStatus?
  claimStrength              InnocenceClaimStrength @default(UNASSESSED)
  crimeDate                  DateTime?
  convictionYear             Int?
  exonerationOrReleaseYear   Int?
  timeServed                 String?
  sentence                   String?            @db.Text
  caseLocationCity           String?
  caseLocationCounty         String?
  caseLocationState          String?
  caseLocationCountry        String             @default("USA")
  narrativeSummary           String?            @db.Text
  aiGenerated                Boolean            @default(true)
  verificationStatus         VerificationStatus @default(UNVERIFIED)
  verifiedAt                 DateTime?
  verifiedById               Int?
  verifiedBy                 User?              @relation("IndividualVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes          String?            @db.Text
  ingestionSource            String?
  importBatchId              String?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  // --- Relationships ---
  mediaItemAppearances       MediaItem[]        @relation("ItemFeaturingIndividuals")
  contributingFactors        ContributingFactor[] @relation("FactorsInIndividualCase")
  organizationsInvolved      Organization[]     @relation("OrganizationsInIndividualCase")
  involvedPersons            InvolvedPerson[]   @relation("PersonsInIndividualCase")

  crimeCategory              CrimeCategory?     @relation(fields: [crimeCategoryId], references: [id])
  crimeCategoryId            Int?

  relatedIndividuals         Individual[]       @relation("RelatedIndividuals")
  relatedToIndividuals       Individual[]       @relation("RelatedIndividuals")

  sourceLinks                IndividualSourceLink[] @relation("IndividualLinks")
  groups                     IndividualGroup[]  @relation("IndividualGroupMembership")
  featuredSettings           FeaturedContentSetting[] @relation("FeaturedStory")

  @@unique([firstName, middleName, lastName, suffix, disambiguationTag])
  @@index([lastName])
  @@index([status])
  @@index([claimStrength])
  @@index([caseLocationState])
  @@index([verificationStatus])
  @@map("individuals")
}

// --- Organization Model ---
model Organization {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  type                 OrganizationType?
  locationCity         String?
  locationState        String?
  locationCountry      String               @default("USA")
  website              String?
  notes                String?              @db.Text // Used for Mission/Description
  aiGenerated          Boolean              @default(true)
  verificationStatus   VerificationStatus   @default(UNVERIFIED)
  verifiedAt           DateTime?
  verifiedById         Int?
  verifiedBy           User?                @relation("OrganizationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes    String?              @db.Text
  ingestionSource      String?
  importBatchId        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  // --- Relationships ---
  mediaItemMentions    MediaItem[]          @relation("ItemMentioningOrganizations")
  involvedCases        Individual[]         @relation("OrganizationsInIndividualCase")
  affiliatedPersons    InvolvedPerson[]     @relation("PersonsAffiliatedWithOrganization")
  externalLinks        OrganizationLink[]
  relatedOrganizations Organization[]       @relation("RelatedOrganizations")
  relatedToOrganizations Organization[]     @relation("RelatedOrganizations")
  factorsAddressed     ContributingFactor[] @relation("FactorRelatedOrganizations")
  featuredSettings     FeaturedContentSetting[] @relation("FeaturedOrganization")

  @@index([verificationStatus])
  @@map("organizations")
}

// --- ContributingFactor Model ---
model ContributingFactor {
  id                   Int                @id @default(autoincrement())
  name                 String             @unique
  description          String?            @db.Text
  aiGenerated          Boolean            @default(true)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  verifiedAt           DateTime?
  verifiedById         Int?
  verifiedBy           User?              @relation("FactorVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes    String?            @db.Text
  ingestionSource      String?
  importBatchId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // --- Relationships ---
  individualCases      Individual[]     @relation("FactorsInIndividualCase")
  mediaItemMentions    MediaItem[]      @relation("ItemMentioningFactors")
  relatedPersons       InvolvedPerson[] @relation("FactorRelatedPersons")
  relatedOrganizations Organization[]   @relation("FactorRelatedOrganizations")

  @@index([verificationStatus])
  @@map("contributing_factors")
}

// --- CrimeCategory Model ---
model CrimeCategory {
  id             Int          @id @default(autoincrement())
  crime_name     String       @unique // Field name kept as crime_name to match existing
  severity_order Int?         // Made optional as per schema.txt not having it required

  // --- Relationships ---
  individuals Individual[]

  @@map("crime_categories")
}


// --- InvolvedPerson Model ---
model InvolvedPerson { // Represents Other Involved Persons (OIPs) - non-WC
  id                Int                  @id @default(autoincrement())
  firstName         String
  middleName        String?
  lastName          String
  suffix            String?
  nickname          String?
  role              InvolvedPersonRole?
  notes             String?              @db.Text
  canonicalKey      String?              @unique
  aiGenerated       Boolean              @default(true)
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  verifiedAt        DateTime?
  verifiedById      Int?
  verifiedBy        User?                @relation("PersonVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verificationNotes String?              @db.Text
  ingestionSource   String?
  importBatchId     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // --- Relationships ---
  mediaItemMentions MediaItem[]          @relation("ItemMentioningPersons")
  involvedCases     Individual[]         @relation("PersonsInIndividualCase")
  affiliatedOrgs    Organization[]       @relation("PersonsAffiliatedWithOrganization")
  relatedFactors    ContributingFactor[] @relation("FactorRelatedPersons")

  @@unique([firstName, middleName, lastName, suffix, role]) // Modified to include role for better uniqueness
  @@index([verificationStatus])
  @@map("involved_persons")
}


// --- OrganizationLink Model ---
model OrganizationLink {
  id             Int                   @id @default(autoincrement())
  url            String
  description    String?               @db.Text
  type           OrganizationLinkType?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // --- Relationships ---
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId Int

  @@map("organization_links")
}

// --- FeaturedContentSetting Model ---
model FeaturedContentSetting {
  id                  Int           @id @default(1) // Use a fixed ID for the single settings row
  featuredStoryId     Int?          // Store Individual ID
  featuredStory       Individual?   @relation("FeaturedStory", fields: [featuredStoryId], references: [id], onDelete: SetNull)
  featuredBookId      Int?          // Store MediaWork ID
  featuredBook        MediaWork?    @relation("FeaturedBook", fields: [featuredBookId], references: [id], onDelete: SetNull)
  featuredPodcastId   Int?          // Store MediaWork ID
  featuredPodcast     MediaWork?    @relation("FeaturedPodcast", fields: [featuredPodcastId], references: [id], onDelete: SetNull)
  featuredFilmId      Int?          // Store MediaWork ID
  featuredFilm        MediaWork?    @relation("FeaturedFilm", fields: [featuredFilmId], references: [id], onDelete: SetNull)
  featuredOrgId       Int?          // Store Organization ID
  featuredOrg         Organization? @relation("FeaturedOrganization", fields: [featuredOrgId], references: [id], onDelete: SetNull)
  featuredFactorIds   Int[]         // Store array of ContributingFactor IDs
  updatedAt           DateTime      @updatedAt

  @@map("featured_content_settings")
}
